# =====================================================================
# Build context exclusions.
# ---------------------------------------------------------------------
# The build context is the REPO ROOT (docker-compose.yml uses context: .),
# because the Dockerfiles reference agents/<component>/... paths. Without
# this file every build packages and uploads the entire repo — including
# the virtualenv, git history, and data/, which holds real lead records.
#
# None of that reaches the image; it is all transmitted as context. This
# keeps builds fast and keeps production data out of the build service.
# =====================================================================

# --- Version control and CI -------------------------------------------
.git
.github
.gitignore

# --- Virtualenvs and Python caches ------------------------------------
.venv
venv
__pycache__
**/__pycache__
.pytest_cache
*.pyc
*.pyo
*.egg-info

# --- Real lead data: never needed in any image ------------------------
# data/seeds/b2b/output/lead_profiles_decision_makers.json contains 263
# production contacts with names, emails and phone numbers.
data/

# --- Docs, tests and infra: not part of any runtime image -------------
docs/
tests/
infra/
conftest.py
pytest.ini

# --- Secrets: belt and braces -----------------------------------------
# The gateway's HubSpot client secret lives in
# agents/gateway/config/.env. This guarantees no .env can ever enter a
# build context, even by accident. .env.example is kept.
**/.env
!**/.env.example

# --- Local scratch -----------------------------------------------------
*.log
.DS_Store
REMOVE-STRAY-BRANCH.bat
