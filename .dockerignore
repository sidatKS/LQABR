# Keep the image build context minimal and — critically — keep secrets out.
# NOTE: `gcloud builds submit` auto-derives .gcloudignore from .gitignore, but
# a LOCAL `docker build` from the repo root has no such safety net: without
# this file, `COPY agents/<dir>` would bake agents/*/.env (real API keys)
# straight into the pushed image.
.git
.github
.gcloud
.vscode
.pytest_cache
**/.pytest_cache
**/__pycache__
**/*.py[cod]
.venv
venv
**/.venv
_to_delete
**/_to_delete
**/.adk

# Secrets — never in an image layer
.env
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
service-account*.json
gcp-credentials*.json

# Not needed inside the runtime image
docs
data
tests
**/tests
