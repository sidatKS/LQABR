# =====================================================================
# Local run config for the HubSpot MCP container (sourced by mcp_run.sh).
# The `: "${VAR:=...}"` form means an env var of the same name OVERRIDES
# the value here — precedence: environment > this file > (no code default).
# =====================================================================
: "${MCP_IMAGE:=tne736/lqabr-mcp-server:latest}"
: "${MCP_CONTAINER:=lqabr-mcp-local}"
: "${MCP_HOST_PORT:=8091}"
# Host log file (relative to repo root, or absolute). Its directory is mounted
# into the container and the server's stdout is tee'd to it.
: "${MCP_LOG_FILE:=logs/mcp/hubspot.log}"
: "${MCP_SECRET_PROJECT:=ldqfingsrv-dev}"
: "${MCP_SECRET_NAME:=lqabr-hubspot-access-token}"
: "${MCP_ADC_FILE:=$HOME/.config/gcloud/application_default_credentials.json}"
