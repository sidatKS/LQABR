# HubSpot MCP container — copy to mcp/.env (git-ignored) and fill the token.
# The container resolves the HubSpot token from THIS env in local dev.
LQABR_SECRETS_SOURCE=env
# The HubSpot private-app token (portal 246777241). Maps to the secret
# lqabr-hubspot-access-token. NEVER commit the real value.
LQABR_HUBSPOT_ACCESS_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
