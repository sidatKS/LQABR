# Cleaned up 2026-08-14 (user request): Twilio credentials removed entirely —
# the prod path (SERVICE_KIND=webhook -> tools:app) is Vapi-only and never
# reads them; Twilio is configured inside the Vapi dashboard instead. The
# only place that used them directly (webhook_app.py, text_voice_agent.py)
# is the retired/dev-only "agent" service kind, not the deployed one.
#
# ANTHROPIC_API_KEY / LQABR_HUBSPOT_ACCESS_TOKEN also removed — both resolve
# correctly through Secret Manager (get_secret checks env first, so leaving a
# placeholder here would have silently shadowed the working value).


# --- Anthropic (model routed through lqabr_core.model.build_model -> LiteLlm) ---
LQABR_TEXT_VOICE_MODEL=anthropic/claude-sonnet-5

# paste your Vapi PRIVATE api key (dashboard -> Api Keys)
LQABR_VAPI_API_KEY=9ad3680a-5081-4426-98b5-decce108d588
# paste the free number's id (dashboard -> Phone Numbers)
LQABR_VAPI_PHONE_NUMBER_ID=e4a65189-cede-4207-a7a7-50431102136e
# harmless HTTPS placeholder: the live test POLLS for the report, so the
# callback never needs to be reachable — it just needs to be a URL Vapi accepts
# Left unset here on purpose (was https://example.com/vapi/report, also
# the pre-2026-08-04 route name -- that value was a deliberate no-op
# placeholder for the ADK `test <id>` POLLING flow, which never needs
# this to be reachable). We're now testing the PUSH flow (push_test.sh),
# which exports this itself to the live cloudflared tunnel URL each run,
# so it must not be hard-coded to a dead URL here -- a manual uvicorn
# start without push_test.sh falls through to GATEWAY_BASE_URL instead.
# LQABR_VAPI_REPORT_CALLBACK_URL=

# Dashboard-managed Vapi assistant "LQABR Text-Voice Outreach" (2026-07-31):
# script/questions live in the Vapi dashboard; code sends only assistantId + per-lead variables.
LQABR_VAPI_ASSISTANT_ID=4f00be12-203d-468f-a11d-f45798165983
