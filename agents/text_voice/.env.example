# agents/text_voice — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).
#
# Rev 5: voice runs on Vapi. There is no Twilio here and no SMS leg — the
# A2P 10DLC (error 30034) blocker that stalled SMS does not apply to this agent.
#
# Every name below is read by the code. Nothing here is decorative: if a
# variable stops being read, delete it from this file in the same change.
# Never put an inline comment on a value line — dotenv reads it as part of
# the value.

# --- Model (Step 7 reads the transcript and decides the outcome) ---
LQABR_TEXT_VOICE_MODEL=anthropic/claude-sonnet-5

# --- Step 5: the central MCP server (2026-08-19: real MCP protocol) ---
# Streamable-HTTP endpoint of the Lead Profile team's MCP server. All CRM
# reads/writes go through it — this agent holds no HubSpot client anymore.
# Local dev default; swap for the production endpoint when it exists.
LQABR_MCP_BASE_URL=http://localhost:8080/mcp
LQABR_MCP_TIMEOUT_SECONDS=30

# --- Vapi (Step 4: the one outbound telephony leg) ---
# Secret Manager: lqabr-vapi-api-key  (the org's PRIVATE key, not the public
# one). Env-only by design — this credential is not read from Secret Manager
# at runtime.
LQABR_VAPI_API_KEY=your-vapi-private-api-key
# The Vapi phone number calls originate from. Without it Step 4 refuses to
# dial and logs config.incomplete at startup.
LQABR_VAPI_PHONE_NUMBER_ID=
# REQUIRED. The call script lives only in the dashboard assistant; an unset
# value raises VapiError rather than posting a call with no assistant.
LQABR_VAPI_ASSISTANT_ID=
# Override only to point at a Vapi mock in tests.
LQABR_VAPI_BASE_URL=https://api.vapi.ai

# --- Step 3 eligibility ---
# Comma-separated lqabr_email_status values that qualify a lead for a call.
# Rev 5 says the workflow fires on "clicked", but the real enumeration in
# portal 246777241 has no CLICKED option (PENDING/SENT/DELIVERED/OPENED/
# FAILED/BOUNCED), so OPENED is the value in use.
LQABR_QUALIFIED_EMAIL_STATUSES=OPENED

# --- Outreach identity ---
# Unset is accepted: the assistant introduces itself as "the LQABR team"
# (confirmed 2026-08-18). Set it to a real person's name to override.
LQABR_SENDER_NAME=Your Name

# --- lead_context (the per-lead blog summary + deep research) ---
# Trimmed to this many characters on a word boundary before it reaches the
# Vapi {{lead_context}} variable.
LQABR_LEAD_CONTEXT_MAX_CHARS=1000

# --- Observability ---
# JSON lines on stdout (what Cloud Run ingests). Set to 0 for readable local
# logs. Both are read by lqabr_core.observability.
LQABR_LOG_JSON=1
LQABR_LOG_LEVEL=INFO

# --- Model provider auth ---
# Resolved at Step 7 from Secret Manager (lqabr-anthropic-api-key), which
# overwrites any value set here. Kept for offline runs with no GCP auth.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Only needed if LQABR_TEXT_VOICE_MODEL is switched to a gemini-* name.
# GOOGLE_API_KEY=your-google-ai-studio-key
