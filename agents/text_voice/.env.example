# agents/text_voice — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).

LQABR_TEXT_VOICE_MODEL=gemini-2.0-flash

# Twilio (Secret Manager: lqabr-twilio-account-sid / lqabr-twilio-auth-token)
LQABR_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LQABR_TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Public base URL of this agent's webhook service (Cloud Run URL in gcp envs;
# an ngrok/tunnel URL for local Twilio testing)
LQABR_WEBHOOK_BASE_URL=https://lqabr-text-voice-webhook-xxxx.a.run.app

# HubSpot (Secret Manager: lqabr-hubspot-access-token)
LQABR_HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

LQABR_SENDER_NAME=Your Name

# Local testing only — skips Twilio signature validation. NEVER set in gcp envs.
# LQABR_SKIP_TWILIO_SIGNATURE=1

# --- Gemini auth ---
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-google-ai-studio-key
