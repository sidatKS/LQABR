# agents/text_voice — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).
#
# NAMES ONLY — never commit a value here. Defaults are documented in the
# comment above each name; an unset name falls back to that default in code.
# Never put a comment on a value line: dotenv reads it as part of the value.
#
# Rev 5: voice runs on Vapi. There is no Twilio here and no SMS leg — the
# A2P 10DLC (error 30034) blocker that stalled SMS does not apply to this agent.
#
# Every name below is read by the code. If a name stops being read, delete it
# from this file in the same change.

# --- Model (Step 7 reads the transcript and decides the outcome) ---
# Default: anthropic/claude-sonnet-5
LQABR_TEXT_VOICE_MODEL=

# --- Step 5: the central MCP server (2026-08-19: real MCP protocol) ---
# Streamable-HTTP endpoint of the Lead Profile team's MCP server. All CRM
# reads/writes go through it — this agent holds no HubSpot client anymore.
# Default: http://localhost:8080/mcp  (swap for the production endpoint)
LQABR_MCP_BASE_URL=
# Default: 30
LQABR_MCP_TIMEOUT_SECONDS=

# --- Vapi (Step 4: the one outbound telephony leg) ---
# Secret Manager: lqabr-vapi-api-key (the org's PRIVATE key, not the public
# one). Env-only by design — not read from Secret Manager at runtime.
LQABR_VAPI_API_KEY=
# The Vapi phone number calls originate from. Unset means Step 4 refuses to
# dial and logs config.incomplete at startup.
LQABR_VAPI_PHONE_NUMBER_ID=
# REQUIRED. The call script lives only in the dashboard assistant; unset
# raises VapiError rather than posting a call with no assistant.
LQABR_VAPI_ASSISTANT_ID=
# Default: https://api.vapi.ai  (override only to point at a mock in tests)
LQABR_VAPI_BASE_URL=

# --- Step 3 eligibility ---
# Comma-separated lqabr_email_status values that qualify a lead for a call.
# Rev 5 says the workflow fires on "clicked", but the real enumeration in
# portal 246777241 has no CLICKED option (PENDING/SENT/DELIVERED/OPENED/
# FAILED/BOUNCED). Default: OPENED
LQABR_QUALIFIED_EMAIL_STATUSES=

# --- Outreach identity ---
# Unset is accepted and correct: the assistant introduces itself as
# "the LQABR team" (confirmed 2026-08-18). Set to a real name to override.
LQABR_SENDER_NAME=

# --- lead_context (the per-lead blog summary + deep research) ---
# Trimmed to this many characters on a word boundary before it reaches the
# Vapi {{lead_context}} variable. Default: 1000
LQABR_LEAD_CONTEXT_MAX_CHARS=

# --- Observability ---
# Read by lqabr_core.observability. JSON lines on stdout is what Cloud Run
# ingests; 0 gives readable local logs. Defaults: 1 and INFO
LQABR_LOG_JSON=
LQABR_LOG_LEVEL=

# --- Model provider auth ---
# Resolved at Step 7 from Secret Manager (lqabr-anthropic-api-key), which
# overwrites any value set here. Kept for offline runs with no GCP auth.
ANTHROPIC_API_KEY=
# Only needed if LQABR_TEXT_VOICE_MODEL is switched to a gemini-* name.
GOOGLE_API_KEY=
