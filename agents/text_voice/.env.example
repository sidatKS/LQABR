# agents/text_voice — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).
#
# Rev 5: voice runs on Vapi. There is no Twilio here and no SMS leg — the
# A2P 10DLC (error 30034) blocker that stalled SMS does not apply to this agent.

# --- Model (Step 7 reads the transcript and decides the outcome) ---
LQABR_TEXT_VOICE_MODEL=anthropic/claude-sonnet-5

# --- Step 5: the central MCP server (2026-08-19: real MCP protocol) ---
# Streamable-HTTP endpoint of the Lead Profile team's MCP server. All CRM
# reads/writes go through it — this agent holds no HubSpot client anymore.
# Local dev default; swap for the production endpoint when it exists.
LQABR_MCP_BASE_URL=http://localhost:8080/mcp

# --- Vapi (Step 4: the one outbound telephony leg) ---
# Secret Manager: lqabr-vapi-api-key  (the org's PRIVATE key, not the public one)
LQABR_VAPI_API_KEY=your-vapi-private-api-key
# The Vapi phone number calls originate from. Without it Step 4 cannot dial.
LQABR_VAPI_PHONE_NUMBER_ID=
# Optional: use a dashboard-managed assistant instead of the transient assistant
# built in tools.py. Leave unset to keep the call script in version control.
LQABR_VAPI_ASSISTANT_ID=
# Voice / call-model providers (config-driven, never hard-coded).
LQABR_VAPI_VOICE_PROVIDER=vapi
LQABR_VAPI_VOICE_ID=Elliot
LQABR_VAPI_CALL_MODEL_PROVIDER=openai
LQABR_VAPI_CALL_MODEL=gpt-4o-mini
LQABR_VAPI_MAX_CALL_SECONDS=300

# --- This service's public base URL ---
# Vapi posts the end-of-call report to <this>/vapi/report, so a wrong value here
# means every call runs and no result is ever recorded. Cloud Run URL in gcp
# envs; an ngrok/tunnel URL for local testing.
LQABR_GATEWAY_BASE_URL=https://lqabr-text-voice-webhook-xxxx.a.run.app

# --- Webhook authenticity ---
# Step 6->7: the shared secret Vapi presents on /vapi/report.
# Secret Manager: lqabr-vapi-webhook-secret
LQABR_VAPI_WEBHOOK_SECRET=generate-a-long-random-string
# Step 2: HubSpot signature v3/v2 needs a public app's CLIENT SECRET. A portal
# with only a private app has none — leave this unset and use the shared token.
# Secret Manager: lqabr-hubspot-client-secret
# LQABR_HUBSPOT_CLIENT_SECRET=
# Fallback for the private-app case: a shared secret the HubSpot workflow sends
# in the X-LQABR-Webhook-Token header.
# Secret Manager: lqabr-hubspot-webhook-token
LQABR_HUBSPOT_WEBHOOK_TOKEN=generate-a-long-random-string

# --- HubSpot (Steps 3 and 8) ---
# Secret Manager: lqabr-hubspot-access-token — the private-app token.
# NOTE the exact variable name. lqabr_core.secrets resolves the secret
# `lqabr-hubspot-access-token` to the env var LQABR_HUBSPOT_ACCESS_TOKEN; a
# variable named anything else (e.g. Hubspot_API_KEY) is NOT picked up, and the
# agent falls through to querying Secret Manager instead.
LQABR_HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# --- Step 1 eligibility ---
# Rev 5 says the workflow fires when email_status becomes "clicked", but the real
# lqabr_email_status enumeration in portal 246777241 has no CLICKED option
# (PENDING/SENT/DELIVERED/OPENED/FAILED/BOUNCED), so OPENED is the value in use.
LQABR_TEXT_VOICE_ELIGIBLE_EMAIL_STATUS=OPENED
# Set to 1 to make an ineligible email_status block the call rather than only
# logging a warning.
# LQABR_TEXT_VOICE_ENFORCE_ELIGIBILITY=1

# --- Outreach identity ---
LQABR_SENDER_NAME=Your Name

# --- Observability ---
# JSON lines on stdout (what Cloud Run ingests). Set to 0 for readable local logs.
LQABR_LOG_JSON=1
LQABR_LOG_LEVEL=INFO

# --- Local testing only. NEVER set in a gcp env. ---
# LQABR_SKIP_HUBSPOT_SIGNATURE=1
# LQABR_SKIP_VAPI_SIGNATURE=1

# --- Model provider auth ---
# Anthropic (Secret Manager: lqabr-anthropic-api-key)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Only needed if LQABR_TEXT_VOICE_MODEL is switched to a gemini-* name
# GOOGLE_API_KEY=your-google-ai-studio-key
