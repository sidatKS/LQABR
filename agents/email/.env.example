# agents/email — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).

LQABR_EMAIL_MODEL=gemini-2.0-flash

# Mailgun (Secret Manager: lqabr-mailgun-api-key / lqabr-mailgun-webhook-signing-key)
LQABR_MAILGUN_API_KEY=your-mailgun-api-key
LQABR_MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=LQABR Outreach <outreach@mg.yourdomain.com>

# HubSpot (Secret Manager: lqabr-hubspot-access-token)
LQABR_HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# Outreach content defaults
LQABR_CTA_URL=https://yourdomain.com/overview
LQABR_SENDER_NAME=Your Name

# --- Gemini auth ---
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-google-ai-studio-key
