# agents/email — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).

LQABR_EMAIL_MODEL=gemini-2.0-flash
LQABR_EMAIL_BATCH_LIMIT=25

# --- The deployed HTTP surface (agents/email/src/service_app.py) ---
# Which route groups this process serves:
#   all       everything — local dev, or a single-service deployment
#   campaign  POST /hubspot/campaign only  (Cloud Run "require authentication")
#   webhook   the Mailgun route only       (public; the HMAC is the boundary)
LQABR_EMAIL_ROUTES=all
# NOTE: /hubspot/campaign and /engagement/sync are currently UNAUTHENTICATED
# — the LQABR_EMAIL_GATEWAY_TOKEN check was removed 2026-08-05 (the gateway
# wasn't sending the header). Nothing replaces it yet; Rev 3's scoped JWTs
# are the intended fix once the gateway track defines them.
# Mount the generic ADK runner under /adk as well, for anything still
# speaking that contract during a transition. Off by default.
# LQABR_EMAIL_MOUNT_ADK=0

# Mailgun (Secret Manager: lqabr-mailgun-api-key / lqabr-mailgun-webhook-signing-key)
LQABR_MAILGUN_API_KEY=your-mailgun-api-key
LQABR_MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key
MAILGUN_DOMAIN=reply.tekninjas.com
# From MUST be on MAILGUN_DOMAIN (the domain Mailgun sends & DKIM-signs as).
# A From on the root domain (yashwanth.b@tekninjas.com) does NOT align with the
# subdomain sender, so clients show the VERP bounce address and "on behalf of":
#   yashwanth.b=tekninjas.com@reply.tekninjas.com on behalf of Yashwanth Bandaru
# Keep From on reply.tekninjas.com; route human replies via MAILGUN_REPLY_TO.
MAILGUN_FROM=Yashwanth Bandaru <yashwanth.b@reply.tekninjas.com>
# Optional. Replies go here instead of the reply.tekninjas.com send address.
MAILGUN_REPLY_TO=yashwanth.b@tekninjas.com

# --- Where credentials come from ---
#   auto           (default) env var first, then the Secret Manager API.
#                  On Cloud Run this IS Secret Manager: --set-secrets reads it
#                  at deploy and injects the value as an env var.
#   secret_manager ignore env entirely, always call the API. Use this to PROVE
#                  a value came from Secret Manager, or to rotate without a
#                  redeploy. Needs roles/secretmanager.secretAccessor.
#   env            never call the API — local dev and tests.
# Whichever answers, the secret NAME and its source are logged (never the value).
LQABR_SECRETS_SOURCE=auto

# --- STEP 4: HubSpot machine-to-machine token (mcp/hubspot/auth.py) ---
# secret_manager (default) — the private-app token already provisioned as
#   lqabr-hubspot-access-token; fetched at runtime, cached for the run.
# oauth2 — client-credentials grant, for when OAuth replaces the private app.
LQABR_HUBSPOT_AUTH_MODE=secret_manager
LQABR_HUBSPOT_TOKEN_TTL_SECONDS=3600
# LOCAL DEV ONLY. In dev/prod this arrives from Secret Manager as
# lqabr-hubspot-access-token — do not paste a real token here.
LQABR_HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token
# Only used when LQABR_HUBSPOT_AUTH_MODE=oauth2:
# LQABR_HUBSPOT_TOKEN_URL=https://auth.example.com/oauth/token
# LQABR_HUBSPOT_CLIENT_ID=your-client-id
# LQABR_HUBSPOT_TOKEN_SCOPE=crm.objects.contacts.read crm.objects.contacts.write
# LQABR_HUBSPOT_CLIENT_SECRET=your-client-secret   (Secret Manager: lqabr-hubspot-client-secret)

# --- HubSpot property names (owned by the HubSpot schema, so config-driven) ---
# email_campaign_complete is a PLACEHOLDER name pending confirmation against
# the owning schema — the single column the voice campaign reads (step 10).
# Set when lqabr_email_status reaches OPENED — that is the hand-off to voice.
LQABR_HUBSPOT_CAMPAIGN_COMPLETE_PROPERTY=email_campaign_complete
LQABR_HUBSPOT_OBJECT_ID_PROPERTY=object_id
# A wrong name here fails the run rather than silently working the
# not-yet-emailed queue, which would email a different set of leads than the
# campaign asked for. Set this ONLY for local exploration:
# LQABR_EMAIL_ALLOW_QUEUE_FALLBACK=0

# Outreach content defaults (substituted into the selected skill template)
LQABR_CTA_URL=https://yourdomain.com/overview
LQABR_SENDER_NAME=Yashwanth Bandaru

# --- Observability: the four log streams ---
# Optional. Tees each stream to <dir>/{system,process,audit,model}_log.jsonl
# alongside stdout. Cloud Run reads stdout, so leave unset there.
# LQABR_EMAIL_LOG_DIR=./.logs
# Off by default: enabling it puts prospect PII (prompt content) in model_log.
LQABR_EMAIL_LOG_MODEL_CONTENT=0

# --- Run state (step 7 -> step 8 bridge) ---
# Held on the agent host itself. Engagement events legitimately arrive days
# after the send, so the host filesystem must be durable — a VM with a
# persistent disk, not a serverless container whose disk dies on restart.
# VM deploy: point this at the PERSISTENT DISK, outside the code tree — a
# redeploy that replaces the checkout would otherwise orphan in-flight runs.
# LQABR_EMAIL_RUNSTATE_DIR=/var/lib/lqabr/email/runstate

# --- Gemini auth ---
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-google-ai-studio-key
# agents/email — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).

LQABR_EMAIL_MODEL=gemini-2.0-flash

# Mailgun (Secret Manager: lqabr-mailgun-api-key / lqabr-mailgun-webhook-signing-key)
LQABR_MAILGUN_API_KEY=your-mailgun-api-key
LQABR_MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=LQABR Outreach <outreach@mg.yourdomain.com>

# HubSpot (Secret Manager: lqabr-hubspot-access-token)
LQABR_HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# Outreach content defaults
LQABR_CTA_URL=https://yourdomain.com/overview
LQABR_SENDER_NAME=Your Name

# --- Gemini auth ---
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-google-ai-studio-key
