# =====================================================================
# agents/gateway — secrets & per-environment values
# ---------------------------------------------------------------------
# Rev 3: "HubSpot private-app token and endpoint URLs live here, never
# hardcoded; swappable per environment (dev / stage / prod)."
#
# Copy to .env and fill in. .env is gitignored at the repo root — never commit
# it. In Cloud Run these come from Secret Manager, not from a file
# (CLAUDE.md §5: secrets come from Secret Manager only).
# =====================================================================

# --- HubSpot -----------------------------------------------------------
# Private app "Agent Gateway" in portal 246777241 (app-na2.hubspot.com).
# Scopes: crm.objects.contacts.read, crm.objects.companies.read
#   (companies is required because industry and annual_revenue live on the
#    company record, not the contact.)
# The gateway itself does not call HubSpot — this token is published to the
# agents through the sidecar's MCP endpoint for their Step 6 lookups.
HUBSPOT_PRIVATE_APP_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client secret of the same private app. Used to verify the v3 signature on
# every inbound webhook. Without it the ingress is an open door: anyone who
# learns the URL could start outreach. Set ingress.signature.enabled=false in
# config.yaml for local dev instead of leaving this blank in production.
HUBSPOT_APP_SECRET=

# --- Gateway -----------------------------------------------------------
# The externally visible origin HubSpot was configured with, e.g.
# https://lqabr-agent-gateway-xxxxx-uc.a.run.app
# Cloud Run rewrites the Host header, so signature verification needs the
# origin HubSpot actually signed.
LQABR_GATEWAY_PUBLIC_URL=

# Cloud Run injects PORT; only set this for local runs.
# PORT=8080

# --- Downstream agent endpoints (A2A) ----------------------------------
# Names must match `endpoint_env` in config/agents_registry.yaml. Swapping an
# agent implementation is a URL change here, never a code edit.
# These are the ONLY place an agent's address is defined, and they decide
# whether the hop goes through the sidecar:
#   http://127.0.0.1:3000/a2a/email   -> through the sidecar (logged, traced)
#   https://lqabr-email-agent-…run.app -> straight at the agent (local dev, or
#                                         if the sidecar is unavailable)
LQABR_EMAIL_AGENT_URL=
LQABR_TEXT_VOICE_AGENT_URL=
LQABR_RESEARCH_AGENT_URL=

# --- Sidecar (Solo.io agentgateway) ------------------------------------
# HubSpot's MCP endpoint, proxied to the agents by the sidecar.
# LQABR_HUBSPOT_MCP_URL=https://mcp.hubspot.com/anthropic
# OpenTelemetry collector for the sidecar's spans; blank disables tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Vapi end-of-call report relay (POST /call-report) -----------------
# Where the gateway forwards a Vapi report, unchanged. This is txtv's
# /call-report route, NOT its A2A/trigger route (/lead).
LQABR_VOICE_REPORT_URL=https://lqabr-dev-txtv-<project-number>.us-central1.run.app/call-report

# Shared secret Vapi sends as x-vapi-secret. The GATEWAY verifies this —
# txtv performs no verification of its own, so leaving this unset with
# vapi.report.signature.enabled=true rejects every report with 401.
# It must also be set on the Vapi assistant (server.headers), or nothing
# is sent to verify.
LQABR_VAPI_WEBHOOK_SECRET=
