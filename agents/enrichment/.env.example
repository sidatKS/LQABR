# agents/enrichment — local dev environment template.
# Copy to `.env` (already git-ignored — see root .gitignore) and fill in
# real values for local runs (`adk web agents/enrichment/src`, `adk run ...`).
#
# CLAUDE.md §5/§9: secrets never get hard-coded or committed. In Cloud
# Run this comes from Secret Manager instead of a .env file.

# Which model the root_agent uses (config-driven — see agent.py MODEL).
LQABR_ENRICHMENT_MODEL=gemini-2.0-flash

# --- Option A: Gemini Developer API (AI Studio) ---
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-google-ai-studio-key

# --- Option B: Vertex AI (use instead of Option A in gcp-backed envs) ---
# GOOGLE_GENAI_USE_ENTERPRISE=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
