# agents/scheduling — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).

LQABR_SCHEDULING_MODEL=gemini-2.0-flash

# Zoom S2S OAuth app (Secret Manager: lqabr-zoom-account-id / -client-id / -client-secret)
LQABR_ZOOM_ACCOUNT_ID=your-zoom-account-id
LQABR_ZOOM_CLIENT_ID=your-zoom-client-id
LQABR_ZOOM_CLIENT_SECRET=your-zoom-client-secret
LQABR_ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret-token
# Optional: skip the Scheduler API lookup and use a fixed booking page
# ZOOM_BOOKING_URL=https://scheduler.zoom.us/your-team/intro-call

# Mailgun (invites go out by email)
LQABR_MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=LQABR Scheduling <scheduling@mg.yourdomain.com>

# HubSpot (Secret Manager: lqabr-hubspot-access-token)
LQABR_HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

LQABR_SENDER_NAME=Your Name

# --- Gemini auth ---
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-google-ai-studio-key
