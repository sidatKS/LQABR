# ============================================================
# agents/summary — Summary Agent
# Copy to `.env` for local runs. Cloud Run injects the real values;
# no .env file exists in production.
#
# EVERY name in this file is env-overridable ON PURPOSE. Renaming a
# HubSpot property or an MCP tool is a CONFIG change, never a code edit.
# ============================================================

# ── Model ────────────────────────────────────────────────────
# LiteLLM model id. The provider key is resolved from the secret
# backend below, so ANTHROPIC_API_KEY need not be in the environment
# on Cloud Run.
LQABR_SUMMARY_MODEL=anthropic/claude-sonnet-5
LQABR_SUMMARY_TEMPERATURE=1.0
# Local dev only — prod resolves this from Secret Manager.
ANTHROPIC_API_KEY=

# ── HubSpot MCP (RUNTIME CONNECTION) ─────────────────────────
# The HubSpot MCP runs as its own container, locally and in cloud.
# This agent speaks the MCP protocol to it over JSON-RPC. It does NOT
# import mcp/hubspot — this URL is the entire coupling.
LQABR_SUMMARY_MCP_BASE_URL=http://localhost:8080/mcp
LQABR_SUMMARY_MCP_TIMEOUT_SECONDS=30
LQABR_SUMMARY_MCP_AUTH_TOKEN=
LQABR_SUMMARY_MCP_PROTOCOL_VERSION=2025-06-18

# Tool names on that server. Discovered via `tools/list` at startup and
# asserted; these are the DEFAULTS to bind, not hard-coded calls. If the
# container ever renames a tool, change it here — no code edit.
LQABR_SUMMARY_MCP_TOOL_READ=get_lead_profile_details
LQABR_SUMMARY_MCP_TOOL_WRITE=post_patch_crm
LQABR_SUMMARY_MCP_TOOL_LIST_LEADS=list_trigger_leads
# Set to 0 to skip the startup tools/list assertion (offline dev only).
LQABR_SUMMARY_MCP_ASSERT_TOOLS=1
# warn = log and keep serving if the MCP is asleep at boot (default)
# strict = refuse to start   |   off = do not check at all
LQABR_SUMMARY_MCP_STARTUP_CHECK=warn
# Argument names the write tool expects.
LQABR_SUMMARY_MCP_ARG_OBJECT_ID=object_id
LQABR_SUMMARY_MCP_ARG_PROPERTIES=properties

# ── HubSpot target (names owned by the HubSpot schema) ───────
LQABR_SUMMARY_HUBSPOT_OBJECT_TYPE=ticket
LQABR_SUMMARY_HUBSPOT_SUMMARY_PROPERTY=blog_summary
LQABR_SUMMARY_HUBSPOT_INDUSTRY_PROPERTY=blog_industry
# 1 = compute and log the write but never send it. Use for the first run.
LQABR_SUMMARY_DRY_RUN=0

# ── Source fetching (url / api adapters) ─────────────────────
LQABR_SUMMARY_HTTP_TIMEOUT_SECONDS=15
LQABR_SUMMARY_MAX_CHARS=50000
LQABR_SUMMARY_MAX_RETRIES=3
# Comma-separated host allowlist. Empty = any PUBLIC host is allowed;
# private, loopback and link-local addresses are refused either way.
LQABR_SUMMARY_ALLOWED_HOSTS=
LQABR_SUMMARY_USER_AGENT=lqabr-summary-agent/0.1

# ── HTTP surface ─────────────────────────────────────────────
# all = domain API + AG-UI /chat. api = domain only. chat = AG-UI only.
LQABR_SUMMARY_ROUTES=all
LQABR_SUMMARY_ENABLE_AGUI=1
LQABR_SUMMARY_CORS_ORIGINS=http://localhost:5173
PORT=8080

# ── Secrets + logging ────────────────────────────────────────
# env | secret_manager | auto
LQABR_SUMMARY_SECRETS_SOURCE=env
LQABR_SUMMARY_GCP_PROJECT=
LQABR_SUMMARY_LOG_LEVEL=INFO
