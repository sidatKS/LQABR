# agents/orchestrator — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets).

LQABR_ORCHESTRATOR_MODEL=gemini-2.0-flash

# A2A endpoints of the stage agents (Cloud Run URLs from 05_deploy_agents.sh;
# local `adk api_server` URLs for dev)
LQABR_LEAD_PROFILE_AGENT_URL=http://localhost:8001
LQABR_EMAIL_AGENT_URL=http://localhost:8002
LQABR_TEXT_VOICE_AGENT_URL=http://localhost:8003
LQABR_SCHEDULING_AGENT_URL=http://localhost:8004

# HubSpot (Secret Manager: lqabr-hubspot-access-token)
LQABR_HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# --- Gemini auth ---
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-google-ai-studio-key
