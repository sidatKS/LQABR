# ============================================================
# agents/research — Research Agent
# Copy to `.env` for local runs (git-ignored). Cloud Run injects the real
# values; no .env file exists in production.
#
# NAMES ONLY in this file — never a real credential value.
#
# Every knob here also lives in config/config.yaml. The environment WINS, so
# use these to override per deployment; leave them unset to take the config map.
# ============================================================

# ── Model ────────────────────────────────────────────────────
LQABR_RESEARCH_MODEL=claude-sonnet-4-6
LQABR_RESEARCH_MAX_TOKENS=2000
# Local dev only — in gcp this resolves from Secret Manager as
# lqabr-anthropic-api-key. Powers BOTH the model call and the web search.
# No credential belongs in this file. The model key and the HubSpot token are
# both read from Secret Manager at run time, by the names below.
LQABR_RESEARCH_MODEL_TOKEN_SECRET=lqabr-anthropic-api-key
# Optional local override; leave empty to use Secret Manager.
ANTHROPIC_API_KEY=

# ── HubSpot MCP (the ONLY door to HubSpot) ───────────────────
LQABR_RESEARCH_MCP_BASE_URL=http://localhost:8091/mcp
LQABR_RESEARCH_MCP_PROTOCOL_VERSION=2025-06-18
LQABR_RESEARCH_MCP_AUTH_TOKEN=
LQABR_RESEARCH_MCP_TOOL_READ_LEAD=get_lead_profile
LQABR_RESEARCH_MCP_TOOL_READ_BLOG=get_blog_summary
LQABR_RESEARCH_MCP_TOOL_WRITE=upsert_lead_profile
LQABR_RESEARCH_MCP_ASSERT_TOOLS=1
LQABR_RESEARCH_MCP_STARTUP_CHECK=warn
# LQABR_RESEARCH_MCP_TIMEOUT_SECONDS=60
# LQABR_RESEARCH_MAX_RETRIES=3

# ── HubSpot target ───────────────────────────────────────────
LQABR_RESEARCH_HUBSPOT_CONTEXT_PROPERTY=lead_context
LQABR_RESEARCH_DRY_RUN=0
LQABR_RESEARCH_SKIP_IF_CONTEXT_PRESENT=0

# ── Web search ───────────────────────────────────────────────
LQABR_RESEARCH_SEARCH_ENABLED=1
LQABR_RESEARCH_SEARCH_MAX_USES=5
# LQABR_RESEARCH_SEARCH_ALLOWED_DOMAINS=
# LQABR_RESEARCH_SEARCH_BLOCKED_DOMAINS=

# ── Note shape ───────────────────────────────────────────────
LQABR_RESEARCH_NOTE_TARGET_WORDS=160
LQABR_RESEARCH_INCLUDE_SOURCES=1

# ── HTTP surface ─────────────────────────────────────────────
LQABR_RESEARCH_ROUTE_A2A=/research/a2a
LQABR_RESEARCH_ROUTE_RUN=/research/run
PORT=8086

# ── Secrets + logging ────────────────────────────────────────
LQABR_RESEARCH_SECRETS_SOURCE=env
LQABR_RESEARCH_LOG_LEVEL=INFO
# LQABR_RESEARCH_LOG_FILE=logs/agents/research/agent.log
