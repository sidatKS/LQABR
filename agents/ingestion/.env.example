# agents/ingestion — local dev template. Copy to `.env` (git-ignored).
# In Cloud Run these values are injected from Secret Manager (--set-secrets);
# never hard-code or commit real values.

LQABR_INGESTION_MODEL=gemini-2.0-flash
ZOOMINFO_BATCH_SIZE=20

# ZoomInfo API credentials (Secret Manager: lqabr-zoominfo-username/-password)
LQABR_ZOOMINFO_USERNAME=your-zoominfo-username
LQABR_ZOOMINFO_PASSWORD=your-zoominfo-password

# HubSpot private-app token (Secret Manager: lqabr-hubspot-access-token)
LQABR_HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# --- Gemini auth: Option A (AI Studio) ---
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-google-ai-studio-key
# --- Option B (Vertex AI) ---
# GOOGLE_GENAI_USE_ENTERPRISE=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
