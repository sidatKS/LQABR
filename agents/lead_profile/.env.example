# ADK reads .env from THE AGENT DIRECTORY, not the repo root.
# Copy this to agents/lead_profile/.env for `adk run` / `adk web`.
#
# THERE ARE NO SECRET VALUES IN THIS FILE, AND THERE MUST NEVER BE ANY.
# Credentials live in Google Secret Manager and are fetched at runtime under the
# service account's identity (context §7.6, CLAUDE.md §5). What you set here are
# the NON-SECRET names that say WHICH entry to read. See docs/SECRETS.md.

# --- orchestrator -----------------------------------------------------------
# deterministic (default) BaseAgent pipeline, no model, no API key.
# llm                     opt-in conversational console over the same tools.
LQABR_ORCHESTRATOR=deterministic

# --- where secrets come from ------------------------------------------------
# gcp  (default) Secret Manager API at runtime. Production. Fails closed.
# env            read from the process environment. LOCAL DEV / CI ONLY.
LQABR_SECRET_BACKEND=gcp
LQABR_SECRET_PROJECT=
LQABR_SECRET_TTL_SECONDS=900

# Which Secret Manager entry backs each credential. A bare id resolves to
# .../versions/latest; give a full projects/../secrets/../versions/N to pin.
# Unset falls back to lqabr-<lower-kebab-name>.
LQABR_SECRET_ANTHROPIC_API_KEY=
LQABR_SECRET_HUBSPOT_PRIVATE_APP_TOKEN=
LQABR_SECRET_HUBSPOT_CLIENT_ID=
LQABR_SECRET_HUBSPOT_CLIENT_SECRET=
LQABR_SECRET_HUBSPOT_REFRESH_TOKEN=

# --- the orchestrating model (LQABR_ORCHESTRATOR=llm only) ------------------
# provider-qualified (contains "/") -> routed through LiteLLM; its API key is
# resolved lazily from Secret Manager on the first model call and is never
# written to os.environ.
LQABR_AGENT_MODEL=anthropic/claude-sonnet-4-6

# --- HubSpot auth -----------------------------------------------------------
# private_app   INTERIM. Static long-lived token. Does NOT satisfy the M2M
#               requirement — tracked as an open item (docs/AUTH.md).
# refresh_token TARGET. Mints a fresh ~30 min token at runtime.
# No default: unset is an error, never a silent fallback to the interim mode.
HUBSPOT_AUTH_MODE=private_app

# --- Endpoints / runtime (non-secret) ---------------------------------------
HUBSPOT_API_BASE=https://api.hubapi.com
HUBSPOT_TOKEN_URL=https://api.hubapi.com/oauth/v1/token
HUBSPOT_TOKEN_REFRESH_SKEW_SECONDS=120
HUBSPOT_HTTP_TIMEOUT_SECONDS=30
HUBSPOT_MAX_RETRIES=3
# Consecutive transport failures before the run is treated as a dependency
# outage and halted instead of blaming N leads. 0 disables the breaker.
LQABR_CONSECUTIVE_TRANSPORT_LIMIT=5

# --- Paths ------------------------------------------------------------------
# On Cloud Run point these at a mounted GCS volume — the container filesystem
# is ephemeral and the error files are the never-drop-a-lead evidence.
LQABR_INCOMING_DIR=data/seeds/b2b
LQABR_ERRORS_DIR=errors
LQABR_LOG_DIR=logs
LQABR_LOG_TO_FILE=false

# --- LOCAL DEV ONLY ---------------------------------------------------------
# With LQABR_SECRET_BACKEND=env the resolver reads these plain names instead of
# calling Secret Manager. Never set them in a deployed environment; never commit
# a .env that has values in them.
# ANTHROPIC_API_KEY=
# HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REFRESH_TOKEN=
